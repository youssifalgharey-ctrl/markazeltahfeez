PORT=8081
SERVER_PORT=8081
SERVER_BASE_URL=http://localhost:8081
ENV=production

# Database (PostgreSQL URL provided by Supabase/Neon/Railway/Render)
# Example: postgresql://postgres:your_password@db.xxxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:///./data/authdb.sqlite3

# Security Secrets
SYNC_WEBHOOK_SECRET=AsserigaQuranSyncSecretKey2026!
JWT_SECRET=your_super_strong_random_jwt_secret_here_replace_me
JWT_EXPIRATION_MS=2592000000

# CORS Allowed Origins (Comma separated)
ALLOWED_ORIGINS=http://localhost:8081

# Google Sheets Webhook
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/your-webhook-id/exec

# Gemini AI Key
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Mail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password_here
PAYMENT_ADMIN_EMAIL=your_email@gmail.com
